{
  "name": "showcase-recipe-app",
  "version": "1.0.0",
  "description": "Full-stack image pipeline demo on Zerops — Bun/Hono API with React/Vite frontend, PostgreSQL, Valkey, NATS, and S3.",
  "author": "Zerops",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerops-recipe-apps/showcase-recipe-app.git"
  },
  "homepage": "https://github.com/zerops-recipe-apps/showcase-recipe-app",
  "bugs": {
    "url": "https://github.com/zerops-recipe-apps/showcase-recipe-app/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bun build src/index.ts --outfile dist/index.js --target bun",
    "build:frontend": "cd frontend && bun run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1108.0",
    "hono": "4.13.1",
    "ioredis": "5.9.3",
    "nats": "2.29.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "keywords": [
    "bun",
    "hono",
    "react",
    "vite",
    "zerops",
    "postgresql",
    "nats",
    "demo"
  ]
}
